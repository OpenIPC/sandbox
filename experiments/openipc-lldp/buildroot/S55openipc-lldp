#!/bin/sh

DAEMON=/usr/bin/openipc-lldp
PIDFILE=/var/run/openipc-lldp.pid

is_running() {
	[ -f "$PIDFILE" ] || return 1
	pid="$(cat "$PIDFILE" 2>/dev/null)" || return 1
	case "$pid" in
		''|*[!0-9]*|0|1) return 1 ;;
	esac
	[ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$DAEMON" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

case "$1" in
	start)
		if is_running; then
			exit 0
		fi

		rm -f "$PIDFILE"
		"$DAEMON" -i eth0 >/dev/null 2>&1 &
		echo $! > "$PIDFILE"
		sleep 1
		if ! is_running; then
			rm -f "$PIDFILE"
			echo "Failed to start openipc-lldp" >&2
			exit 1
		fi
		;;

	stop)
		if is_running; then
			kill "$pid" 2>/dev/null

			# Give the daemon time to send its TTL=0 shutdown advertisement.
			i=0
			while is_running && [ "$i" -lt 5 ]; do
				sleep 1
				i=$((i + 1))
			done
		fi

		if is_running; then
			echo "openipc-lldp did not stop; retaining PID file" >&2
			exit 1
		fi
		rm -f "$PIDFILE"
		;;

	restart)
		"$0" stop || exit $?
		"$0" start
		;;

	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
